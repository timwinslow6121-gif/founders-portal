ame":"Palette Color Rating"}],"third-palette":[{"color":"#006cff","slug":"palette1","name":"Palette Color 1"},{"color":"#0056cc","slug":"palette2","name":"Palette Color 2"},{"color":"#2c3040","slug":"palette3","name":"Palette Color 3"},{"color":"#424357","slug":"palette4","name":"Palette Color 4"},{"color":"#494b66","slug":"palette5","name":"Palette Color 5"},{"color":"#63657d","slug":"palette6","name":"Palette Color 6"},{"color":"#e1e9f5","slug":"palette7","name":"Palette Color 7"},{"color":"#f0f4fb","slug":"palette8","name":"Palette Color 8"},{"color":"#fdfdfd","slug":"palette9","name":"Palette Color 9"},{"color":"#FfFfFf","slug":"palette10","name":"Palette Color Complement"},{"color":"#13612e","slug":"palette11","name":"Palette Color Success"},{"color":"#1159af","slug":"palette12","name":"Palette Color Info"},{"color":"#b82105","slug":"palette13","name":"Palette Color Alert"},{"color":"#f7630c","slug":"palette14","name":"Palette Color Warning"},{"color":"#f5a524","slug":"palette15","name":"Palette Color Rating"}],"active":"palette"}";}s:6:"wp_css";s:1524:"/* Adds a professional shadow to the sticky header */
.kadence-sticky-header.is-sticky {
  box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.1);
}
/* --- Final Style for Kadence Accordion "Cards" --- */

/* This rule targets every individual accordion item (pane) */
.wp-block-kadence-accordion .kt-accordion-pane {
    border-radius: 0.5rem !important;
    margin-bottom: 1rem !important;
    overflow: hidden; /* Important for containing the radius */
    
    /* NORMAL STATE: Use the official global shadow */
    box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.1) !important;

    /* Adds a smooth transition for the hover effect */
    transition: box-shadow 0.3s ease !important;
}

/* This adds the "lifting" effect when you hover over an accordion item */
.wp-block-kadence-accordion .kt-accordion-pane:hover {
    /* HOVER STATE: Use the official hover shadow */
    box-shadow: 0px 6px 16px rgba(0, 0, 0, 0.15) !important;
}
body {
  margin: 0 !important;
  padding: 0 !important;
}

body > .site,
body > .wp-site-blocks {
  padding: 0 !important;
  margin: 0 auto !important;
  max-width: 100% !important;
}

/* FORCE OVERLAY VISIBILITY - FOUNDERS BRAND SHIELD */
.kt-row-layout-overlay {
    opacity: 0.9 !important;
    visibility: visible !important;
    display: block !important;
    z-index: 1 !important;
}

/* ENSURE TEXT STAYS ON TOP */
.kt-row-column-wrap {
    position: relative !important;
    z-index: 2 !important;
}

/* FIX FOR FIXED/PARALLAX BACKGROUNDS */
.kt-row-has-bg {
    isolation: isolate !important;
}
";}